# Server
PORT=3001
NODE_ENV=development
TRUST_PROXY=false
BODY_SIZE_LIMIT=1mb

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dentaleasy?schema=public"

# JWT and Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-second-long-random-secret-at-least-32-characters"
JWT_ISSUER="dentaleasy-backend"
JWT_AUDIENCE="dentaleasy-app"
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_HASH_PEPPER="replace-with-a-random-pepper"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# CORS (comma-separated allowlist, no wildcard)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002"
CORS_CREDENTIALS=true
CORS_ALLOW_NO_ORIGIN=true

# Refresh token cookie
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_EXPOSE_REFRESH_TOKEN_IN_BODY=false
AUTH_REFRESH_COOKIE_NAME=de_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=

# Login brute-force and MFA foundations
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_REQUIRE_MFA_FOR_ADMIN=false
AUTH_VALIDATE_SESSION_ON_REQUEST=false

# Public endpoint rate limits
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_REFRESH_WINDOW_MINUTES=15
RATE_LIMIT_REFRESH_MAX_REQUESTS=30
RATE_LIMIT_FORGOT_WINDOW_MINUTES=60
RATE_LIMIT_FORGOT_MAX_REQUESTS=5
RATE_LIMIT_RESET_WINDOW_MINUTES=60
RATE_LIMIT_RESET_MAX_REQUESTS=10
